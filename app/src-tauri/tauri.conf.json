{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaleSpire Map Viewer",
  "version": "0.3.0",
  "identifier": "com.jsbertsch.talespire-map-viewer",
  "build": {
    "frontendDist": "../../viewer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TaleSpire Map Viewer",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "category": "RolePlayingGame",
    "shortDescription": "3D map viewer for TaleSpire board exports",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
